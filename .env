# ============================================
# STAFFBOT - VERCEL DASHBOARD CONFIGURATION
# ============================================
# This dashboard connects to the same database as your VPS bot.
# Make sure MONGODB_URI, DISCORD_TOKEN, and CLIENT_ID match in both!

# ============================================
# DISCORD CREDENTIALS
# Get these from: https://discord.com/developers/applications
# ============================================

# Discord Client ID (OAuth2 > Client ID)
# IMPORTANT: Must be the same in bot-vps/.env
CLIENT_ID=1446213075861635293

# Discord Client Secret (OAuth2 > Client Secret > Reset Secret)
DISCORD_CLIENT_SECRET=Lw66hoJvG19Qdly0vre5mmuq_aWGG0m_

# Discord Bot Token (Bot > Token > Copy)
# IMPORTANT: Must be the same in bot-vps/.env
# Used to check which guilds have the bot installed
DISCORD_TOKEN=MTQ0NjIxMzA3NTg2MTYzNTI5Mw.Gm5Gdx.4sto3McNY49mj4OSHrB74xxLQlRwf1mm0vw3nA

# ============================================
# DATABASE CONNECTION
# ============================================

# MongoDB Connection URI
# IMPORTANT: Must be the same in bot-vps/.env
# Get from: https://cloud.mongodb.com (MongoDB Atlas)
# Make sure to whitelist 0.0.0.0/0 for Vercel serverless functions
MONGODB_URI=mongodb+srv://ayamibot2:1234K978@ayamibot.5wxd78t.mongodb.net/

# ============================================
# SESSION & SECURITY
# ============================================

# Session Secret - generate a random 32+ character string
# Generate at: https://generate-secret.vercel.app/32
SESSION_SECRET=your_random_session_secret_here

# Node Environment
NODE_ENV=production

# ============================================
# OAUTH2 REDIRECT CONFIGURATION
# ============================================

# Your Vercel deployment URL (set after first deploy)
# Example: https://staffbot-dashboard.vercel.app
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ============================================
# BOT API CONNECTION (connects to your VPS bot)
# ============================================

# Bot API URL - The URL where your VPS bot's API is running
# This is YOUR VPS IP/domain + port where the bot API runs
# IMPORTANT: Must match BOT_API_URL in bot-vps/.env
# Examples:
#   http://123.45.67.89:3001
#   https://bot.yourdomain.com
#   http://your-vps.com:3001
BOT_API_URL=http://ger.visionhost.cloud:10036

# API Secret Key - Used to authenticate requests to the bot API
# IMPORTANT: Must match BOT_API_SECRET in bot-vps/.env
# Generate at: https://generate-secret.vercel.app/32
BOT_API_SECRET=429a406d0d2356d9d362ba6909e13710

# ============================================
# CONNECTING LINKS
# ============================================

# Discord Developer Portal
# https://discord.com/developers/applications

# MongoDB Atlas Dashboard
# https://cloud.mongodb.com

# Bot Invite Link (replace YOUR_CLIENT_ID with actual Client ID)
# https://discord.com/api/oauth2/authorize?client_id=YOUR_CLIENT_ID&permissions=8&scope=bot%20applications.commands

# OAuth2 Redirect URL (add this to Discord Developer Portal > OAuth2 > Redirects)
# https://your-app.vercel.app/api/auth/callback
